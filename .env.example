SERVICE_NAME=Memora-App
NODE_ENV=development
PORT=3001
CORS_URL=http://localhost:3000

CONSOLE_LOG_FORMAT=plain
CONSOLE_LOG_LEVEL=info
ROUTER_LOG_ACTIVATION=true
ROUTER_LOG_FORMAT=tiny

JWT_SECRET=change-me
JWT_EXPIRES=3h

# Optional for now (Redis is effectively unused in code).
# REDIS_URL=

# --- Postgres ---
# Local (compose DB only + npm run dev):
POSTGRES_HOST=localhost
POSTGRES_PORT=5430
POSTGRES_INNER_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=cards
DATABASE_URL=postgres://user:password@localhost:5430/cards

# Prod (docker compose prod overlay overrides host/port/DATABASE_URL for the api
# container). On the VM still set POSTGRES_* credentials + INNER_PORT, e.g.:
# NODE_ENV=production
# CORS_URL=https://your-frontend.example
# POSTGRES_HOST=memora-postgres-db
# POSTGRES_PORT=5432
# POSTGRES_INNER_PORT=5432
# DATABASE_URL=postgres://user:password@memora-postgres-db:5432/cards

POSTGRES_CONNECTION_TIMEOUT=2000
POSTGRES_IDLE_TIMEOUT=3000
POSTGRES_POOL_SIZE=10

FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PRIVATE_VAPID_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# GEMINI_API_KEY=
